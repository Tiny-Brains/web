msgstr "强制执行"

#: src/models/adapters/studio.md:51
msgid "The Studio's version"
msgstr "Studio 的版本"

#: src/models/adapters/studio.md:51
msgid "Whatever that site last deployed"
msgstr "该网站最近一次部署的版本"

#: src/models/adapters/studio.md:51
