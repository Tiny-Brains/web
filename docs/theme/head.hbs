{{!-- mdBook's "custom head" partial, included by index.hbs as {{> head}} before anything is
      painted -- and the one template in theme/ that is ours rather than upstream's, so nothing
      here is a marked edit of a vendored file.

      THE LANGUAGES THE BOOK IS BUILT IN, AND HOW A READER LANDS IN THEIRS. The book is static
      HTML with no runtime, so a language is an address: /docs/ is English and /docs/<tag>/ a
      second build of the same chapters, translated through po/<tag>.po (build.sh makes one per
      catalogue). The application beside it decides its language at runtime from one stored choice,
      `tb.lang`, and this script is the bridge: on a page of the English tree it reads that choice
      -- else the browser's languages, by the whole tag and then by the language alone, exactly as
      the application's lib/lang.ts does -- and when it names a language the book has, goes to the
      same chapter there before the first paint. A page inside a language's tree is an explicit
      address and is never forwarded, so a shared link opens what it says, and a crawler, which
      stores nothing and prefers English, reads every tree where it is.

      ADDING A LANGUAGE IS A LINE IN `languages` HERE, a po/<tag>.po, and the chrome's words in
      theme/tb-words.js; po/check.py refuses a catalogue this table does not name. The name is the
      language's own name for itself, the one word that is the same in every language, as in the
      application's LANGUAGES. `default` is the tree at /docs/ itself. --}}
<script>
    window.tbBook = {
        language: "{{ language }}",
        root: "{{ path_to_root }}",
        default: "en-GB",
        languages: { "en-GB": "English", "zh-CN": "简体中文" },
    };
    (function () {
        var book = window.tbBook, tags = Object.keys(book.languages);
        if (book.language !== book.default) return;
        var want = null;
        try { want = localStorage.getItem("tb.lang"); } catch (e) { }
        if (tags.indexOf(want) < 0) {
            want = null;
            var prefs = (navigator.languages && navigator.languages.length) ? navigator.languages : [navigator.language];
            for (var i = 0; i < prefs.length && !want; i++) {
                var w = String(prefs[i] || "").toLowerCase(), primary = w.split("-")[0];
                for (var j = 0; j < tags.length && !want; j++) if (tags[j].toLowerCase() === w) want = tags[j];
                for (var k = 0; k < tags.length && !want; k++) if (tags[k].split("-")[0].toLowerCase() === primary) want = tags[k];
            }
        }
        if (!want || want === book.language) return;
        var root = new URL(book.root || "./", location.href);
        var page = location.pathname.slice(root.pathname.length);
        location.replace(new URL(want + "/" + page, root).href + location.search + location.hash);
    })();
</script>

