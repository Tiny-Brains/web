# THE PRODUCTION PLATFORM'S SETTINGS, for docker-compose.prod.yml. On the production machine this file
# becomes .env -- `cp .env.prod.example .env` -- so the setup scripts, which read and write .env, work
# unchanged there. Every blank is required: the compose file refuses to start without it, and nothing
# falls back to a committed dev value.
#
# README, *Production*, is the order these are filled in.

# ---- the site ------------------------------------------------------------------------------------
# The hostname the site is served on. Its DNS A record points at this machine BEFORE the first `up`:
# Caddy fetches the certificate for it. The console is https://<SITE_HOST>:8443.
SITE_HOST=
# Where Let's Encrypt writes about the certificate.
ACME_EMAIL=

# ---- the releases this machine runs --------------------------------------------------------------
# Pinned versions, never `:latest`. Soma's and every runner's image must be built from ONE ants
# release, or runners claim nothing (web's scripts/check/configs.sh compares them).
#   SOMA_IMAGE=ghcr.io/tiny-brains/soma:<version>
#   WEB_IMAGE=ghcr.io/tiny-brains/web:<version>
SOMA_IMAGE=
WEB_IMAGE=
#ORION_UI_VERSION=1.9.1

# ---- the production GitHub OAuth App -------------------------------------------------------------
# NOT the local stack's. github.com/settings/developers -> New OAuth App:
#   Homepage URL                 https://<SITE_HOST>
#   Authorization callback URL   https://<SITE_HOST>/v1/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ---- who is an admin -----------------------------------------------------------------------------
# GitHub numeric user ids, comma-separated, never logins. scripts/setup/admin-user.sh <github-login>
# writes yours here.
SOMA_ADMIN_GITHUB_IDS=

# ---- secrets minted on this machine --------------------------------------------------------------
# scripts/setup/admin-key.sh writes ORION_ADMIN_KEY; scripts/setup/trust-keygen.sh writes
# TB_TRUST_PUBLIC_KEY and keeps the private half in keys/. The rest:
#   openssl rand -hex 32     (SOMA_SESSION_SECRET, RUNNER_TOKEN_SECRET -- two different values)
#   openssl rand -hex 24     (RUNNER_GATE_DB_PASSWORD)
ORION_ADMIN_KEY=
TB_TRUST_PUBLIC_KEY=
SOMA_SESSION_SECRET=
RUNNER_TOKEN_SECRET=
RUNNER_GATE_DB_PASSWORD=

# ---- managed Postgres (16 or later) --------------------------------------------------------------
# One server, three databases: `soma` (the platform), `orion_state` (Orion's own; bootstrap creates it
# if the role may), and the provider's maintenance database. Keep `?sslmode=require` on every URL.
# The owner role must own `soma` and hold CREATEDB and CREATEROLE: the schema creates the
# `runner_gate` role.
#   SOMA_DB_URL          postgres://<owner>:<password>@<host>:5432/soma?sslmode=require
#   ORION_STATE_DB_URL   postgres://<owner>:<password>@<host>:5432/orion_state?sslmode=require
#   SOMA_ADMIN_DB_URL    postgres://<owner>:<password>@<host>:5432/postgres?sslmode=require
#   RUNNER_GATE_DB_URL   postgres://runner_gate:<RUNNER_GATE_DB_PASSWORD>@<host>:5432/soma?sslmode=require
# RUNNER_GATE_DB_URL carries the password above: bootstrap sets it on the role.
SOMA_DB_URL=
ORION_STATE_DB_URL=
SOMA_ADMIN_DB_URL=
RUNNER_GATE_DB_URL=

# ---- Cloudflare R2 -------------------------------------------------------------------------------
# The account's S3 endpoint, https://<account-id>.r2.cloudflarestorage.com, with no trailing slash.
# Every runner's R2_S3_ENDPOINT is this exact string.
R2_S3_ENDPOINT=
R2_BUCKET=tinybrains-replays
MODELS_BUCKET=tinybrains-models
# An R2 API token with Object Read & Write on BOTH buckets, and on nothing else.
R2_ACCESS_KEY=
R2_SECRET_KEY=

# ---- optional ------------------------------------------------------------------------------------
# The compose network, which SOMA_TRUSTED_PROXIES trusts. Change it if it collides with a network this
# machine routes to.
#PLATFORM_SUBNET=172.29.250.0/24
#SEASON_GAP_DAYS=1
#ENGINE_RELEASE=0
#SOMA_MEMORY=1g
# 1 only when the managed database is reached over a private network.
#SOMA_ALLOW_PRIVATE_URLS=false
#CACHE_MAXMEMORY=256mb
#LOG_MAX_SIZE=20m
#LOG_MAX_FILE=5
# Orion's log filter. The default drops the two INFO lines every request writes and the one a clock
# writes each time it idles; `info` alone brings them all back while debugging.
#ORION_RUST_LOG=info,dataflow_rs::engine::workflow_executor=warn,dataflow_rs::engine::functions::filter=warn,orion::server::observability=warn

# ---- what sizes the Soma node --------------------------------------------------------------------
# Every one of these is optional: unset (or empty, which is how compose passes it) takes the
# default baked into the Soma image, and soma/README.md, *Node sizing*, explains each one.
#
# THE POSTGRES BUDGET IS THE FIRST THREE: SOMA_DB_MAX_CONNECTIONS + SOMA_GATE_DB_MAX_CONNECTIONS
# connections to `soma`, and SOMA_STATE_DB_MAX_CONNECTIONS to `orion_state` -- 8 + 4 + 15 = 27 by
# default. That is the number a managed Postgres plan has to allow.
#SOMA_DB_MAX_CONNECTIONS=8
#SOMA_GATE_DB_MAX_CONNECTIONS=4
#SOMA_STATE_DB_MAX_CONNECTIONS=15
#SOMA_STATE_DB_MIN_CONNECTIONS=2
# The pool WAIT, not just the dial: sqlx takes connect_timeout as acquire_timeout, so this is what a
# request spends queueing once the pool is full.
#SOMA_DB_CONNECT_TIMEOUT_MS=5000
#SOMA_GATE_DB_CONNECT_TIMEOUT_MS=5000
#SOMA_STATE_DB_ACQUIRE_TIMEOUT_SECS=10

# HOW MANY CLOCKS RUN AT ONCE. Five are declared and the admit clock can hold a worker for its full
# 600 s, so below four is pair, count, withdraw and reap queueing behind it -- an idle ladder on a
# node that looks healthy. Raise it, do not lower it.
#SOMA_CRON_WORKERS=4

# The response cache. Raising these takes load off the database pool AND the node, so reach for them
# before shrinking anything above.
#SOMA_HOT_CACHE_TTL_SECS=10
#SOMA_SEASON_CACHE_TTL_SECS=60

# RATE LIMITS, one pair per family. Defaults as shipped; these exist so a deployment can open them
# up or close them down. soma/docker/soma.toml.tmpl lists all nine with their defaults.
#SOMA_RATE_PUBLIC_RPS=30
#SOMA_RATE_PUBLIC_BURST=60
#SOMA_RATE_SESSION_RPS=20
#SOMA_RATE_SESSION_BURST=40
#SOMA_RATE_PER_USER_READ_RPS=10
#SOMA_RATE_PER_USER_READ_BURST=20
#SOMA_RATE_PER_USER_WRITE_RPS=1
#SOMA_RATE_PER_USER_WRITE_BURST=5
#SOMA_RATE_PER_ADMIN_BOARD_RPS=5
#SOMA_RATE_PER_ADMIN_BOARD_BURST=40
#SOMA_RATE_RUNNER_RPS=30
#SOMA_RATE_RUNNER_BURST=60
#SOMA_RATE_RUNNER_TOKEN_RPS=30
#SOMA_RATE_RUNNER_TOKEN_BURST=60
#SOMA_RATE_PER_RUNNER_RPS=10
#SOMA_RATE_PER_RUNNER_BURST=20
# Sign-in, which mints a session and is limited per address.
#SOMA_RATE_SIGNIN_RPS=5
#SOMA_RATE_SIGNIN_BURST=10
