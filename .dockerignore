node_modules/
dist/
.vite/
*.tsbuildinfo

# The viewer is taken from the cartridge's own image by `COPY --from=ants`, not from whatever a
# local `npm run dev` happened to leave here. Copying it in would let a stale local copy shadow the
# one this Dockerfile names -- which is the drift the image was written to remove.
public/cartridges/

# The book is taken from its own image by `COPY --from=book`, and its own build context is docs/.
# Copying the source in here would put 36 chapters, eight lesson scripts and a rendered book/ into
# the node build context, where nothing reads them.
docs/

.git/
.env
.env.*
!.env.example
*.log
coverage/
