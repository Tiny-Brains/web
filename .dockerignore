node_modules/
dist/
.vite/
*.tsbuildinfo

# The viewer is fetched from the cartridge's own release by the Dockerfile, not taken from whatever a
# local `npm run dev` happened to leave here. Copying it in would let a stale local copy shadow the
# one this Dockerfile names -- which is the drift the release was written to remove.
public/cartridges/

# The book is taken from its own image by `COPY --from=book`, and its own build context is docs/.
# Copying the source in here would put 36 chapters, eight lesson scripts and a rendered book/ into
# the node build context, where nothing reads them.
docs/

.git/
.env
.env.*
*.log
coverage/

# Deployment state left this repository for tinybrains/devops/, so there is nothing here to exclude
# any more. These two stay as a backstop: a stray .env or keys/ made by hand is not an input to the
# application image, and an image that carried one would ship a secret.
keys/
