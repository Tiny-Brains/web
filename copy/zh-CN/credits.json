    {
      "id": "ratings",
      "title": "评分",
      "entries": [
        {
          "name": "TrueSkill",
          "href": "https://www.microsoft.com/en-us/research/publication/trueskilltm-a-bayesian-skill-rating-system/",
          "lic": "研究",
          "note": "Ralf Herbrich、Tom Minka 和 Thore Graepel（微软研究院，2006）。排行榜上的每个评分，都是按他们的更新规则得出的后验。",
          "links": [
            {
              "label": "微软研究院的 TrueSkill 页面",
              "href": "https://www.microsoft.com/en-us/research/project/trueskill-ranking-system/"
            }
          ]
        },
        {
          "name": "`trueskill` 包",
          "href": "https://trueskill.org",
          "lic": "BSD",
          "note": "Heungsub Lee 的实现；我们以它为准测试自己的实现，误差在 1e-9 以内。"
        },
        {
          "name": "Numerical Recipes",
          "href": "https://numerical.recipes",
          "lic": "已发表的方法",
          "note": "Press、Teukolsky、Vetterling 和 Flannery 著。我们的高斯函数所用的误差函数近似出自此书。"
        }
      ]
